{
  "name": "@h3mantd/laravel-cloud",
  "version": "0.1.0",
  "description": "TypeScript SDK for Laravel Cloud.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/h3mantD/laravel-cloud-sdk-ts.git"
  },
  "bugs": {
    "url": "https://github.com/h3mantD/laravel-cloud-sdk-ts/issues"
  },
  "homepage": "https://github.com/h3mantD/laravel-cloud-sdk-ts#readme",
  "keywords": [
    "laravel",
    "laravel-cloud",
    "sdk",
    "typescript"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "docs",
    "openapi/laravel-cloud.openapi.json"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run openapi:check && npm run lint && npm run typecheck && npm test && npm run build && npm run test:exports && npm pack --dry-run",
    "test:exports": "node scripts/smoke/esm.mjs && node scripts/smoke/cjs.cjs",
    "openapi:fetch": "node scripts/fetch-openapi.mjs",
    "openapi:types": "node scripts/generate-openapi-types.mjs",
    "openapi:check": "npm run openapi:types && git diff --exit-code -- src/generated/openapi.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "openapi-typescript": "^7.10.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "6.4.2",
    "vitest": "3.2.4"
  }
}
